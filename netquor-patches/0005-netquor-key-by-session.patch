+/** One POST to the key service; null for any failure (no cookie and no session end in a redirect or a refusal, which is the normal case for the first try) */
+async function fetchKey(
+  url: string,
+  credentials: RequestCredentials,
+  extra: Record<string, string>,
+): Promise<{ token?: unknown; domain?: unknown } | null> {
+  try {
+    const response = await fetch(url, {
+      method: "POST",
+      credentials,
+      redirect: "error",
+      cache: "no-store",
+      headers: { "Content-Type": "application/json", "X-Requested-With": "netquor-vault", ...extra },
+      body: JSON.stringify({ label: "web" }),
+    });
+    return response.ok ? await response.json() : null;
+  } catch {
+    return null;
+  }
+}
+
+/** The person's current Vaultwarden session as an Authorization header (empty when there is none, which makes the key service refuse and nothing else happens) */
+async function sessionHeader(parent: Injector, userId: UserId): Promise<Record<string, string>> {
+  const session = await parent.get(TokenService).getAccessToken(userId);
+  return session ? { Authorization: `Bearer ${session}` } : {};
+}

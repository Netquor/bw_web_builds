+  /** Netquor: when the key is empty on our own addy.io, ask our key service for the person's web key in the background. This works only because this site and alias.netquor.com are the same
+   *  site, so the browser sends the person's existing sign-in cookie for alias.netquor.com with the request. ANY failure (no session yet, redirected to sign-in, offline, blocked) is silent and
+   *  leaves the "Get my key" button, which opens the visible flow. At most one attempt per component and per 10 minutes. */
+  private async netquorAutoConnect() {
+    const base = ForwarderSettingsComponent.netquorBase;
+    if (this.netquorTried || !this.isNetquorAliases || String(this.settings.get(Controls.token)?.value ?? "") !== "") {
+      return;
+    }
+    this.netquorTried = true;
+    try {
+      const last = Number(window.sessionStorage.getItem("netquorAutoKeyTry") ?? "0");
+      if (Date.now() - last < 10 * 60 * 1000) {
+        return;
